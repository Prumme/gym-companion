generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  DELETION_PENDING
}

enum UserRole {
  USER
  ADMIN
}

enum WeightUnit {
  KG
  LB
}

enum DistanceUnit {
  KM
  MI
}

enum TrainingGoal {
  ENDURANCE
  HYPERTROPHY
  STRENGTH
  GENERAL_FITNESS
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EffortTrackingMode {
  NONE
  RIR
  RPE
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique
  passwordHash         String
  status               UserStatus    @default(ACTIVE)
  role                 UserRole      @default(USER)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletionRequestedAt  DateTime?

  profile                 UserProfile?
  sessions                AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  exercises               Exercise[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  id                            String             @id @default(uuid()) @db.Uuid
  userId                        String             @unique @db.Uuid
  displayName                   String
  timezone                      String             @default("Europe/Paris")
  weightUnit                    WeightUnit         @default(KG)
  distanceUnit                  DistanceUnit       @default(KM)
  primaryGoal                   TrainingGoal       @default(GENERAL_FITNESS)
  experienceLevel               ExperienceLevel    @default(BEGINNER)
  effortTrackingMode            EffortTrackingMode @default(NONE)
  heightCm                      Decimal?           @db.Decimal(5, 2)
  currentWeightKg               Decimal?           @db.Decimal(6, 2)
  weeklyTrainingTarget          Int?
  defaultWorkoutDurationMinutes Int?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model MuscleGroup {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  parentId  String?  @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MuscleGroup?  @relation("MuscleGroupHierarchy", fields: [parentId], references: [id])
  children MuscleGroup[] @relation("MuscleGroupHierarchy")

  primaryExercises   Exercise[]                 @relation("ExercisePrimaryMuscle")
  secondaryExercises ExerciseSecondaryMuscle[]

  @@index([parentId])
  @@index([isActive])
  @@map("muscle_groups")
}

model EquipmentType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForExercises Exercise[]                        @relation("ExerciseDefaultEquipment")
  compatibleExercises ExerciseEquipmentCompatibility[]

  @@index([isActive])
  @@map("equipment_types")
}

enum ExerciseSource {
  SYSTEM
  USER
}

enum ExerciseMeasurementType {
  WEIGHT_REPS
  BODYWEIGHT_REPS
  ASSISTED_BODYWEIGHT_REPS
  REPS_ONLY
  DURATION
  DISTANCE_DURATION
  WEIGHT_DURATION
}

model Exercise {
  id                     String                   @id @default(uuid()) @db.Uuid
  ownerUserId            String?                  @db.Uuid
  source                 ExerciseSource
  name                   String
  normalizedName         String
  slug                   String?                  @unique
  primaryMuscleGroupId   String                   @db.Uuid
  measurementType        ExerciseMeasurementType
  defaultEquipmentTypeId String?                  @db.Uuid
  defaultRestSeconds     Int?
  instructions           String?
  archivedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  owner                  User?                             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  primaryMuscleGroup     MuscleGroup                       @relation("ExercisePrimaryMuscle", fields: [primaryMuscleGroupId], references: [id])
  defaultEquipmentType   EquipmentType?                    @relation("ExerciseDefaultEquipment", fields: [defaultEquipmentTypeId], references: [id])
  secondaryMuscles       ExerciseSecondaryMuscle[]
  compatibleEquipment    ExerciseEquipmentCompatibility[]

  @@index([ownerUserId])
  @@index([source])
  @@index([primaryMuscleGroupId])
  @@index([archivedAt])
  @@index([normalizedName, id])
  @@map("exercises")
}

model ExerciseSecondaryMuscle {
  exerciseId    String @db.Uuid
  muscleGroupId String @db.Uuid

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id])

  @@id([exerciseId, muscleGroupId])
  @@map("exercise_secondary_muscles")
}

model ExerciseEquipmentCompatibility {
  id              String  @id @default(uuid()) @db.Uuid
  exerciseId      String  @db.Uuid
  equipmentTypeId String  @db.Uuid
  isPreferred     Boolean @default(false)
  notes           String?

  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@unique([exerciseId, equipmentTypeId])
  @@index([equipmentTypeId])
  @@map("exercise_equipment_compatibilities")
}
