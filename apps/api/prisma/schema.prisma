generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  DELETION_PENDING
}

enum UserRole {
  USER
  ADMIN
}

enum WeightUnit {
  KG
  LB
}

enum DistanceUnit {
  KM
  MI
}

enum TrainingGoal {
  ENDURANCE
  HYPERTROPHY
  STRENGTH
  GENERAL_FITNESS
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EffortTrackingMode {
  NONE
  RIR
  RPE
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique
  passwordHash         String
  status               UserStatus    @default(ACTIVE)
  role                 UserRole      @default(USER)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletionRequestedAt  DateTime?

  profile                 UserProfile?
  sessions                AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  exercises               Exercise[]
  exercisePreferences     UserExercisePreference[]
  programs                Program[]
  workoutTemplates        WorkoutTemplate[]
  programActivations      ProgramActivation[]
  workoutSessions         WorkoutSession[]
  workoutSets             WorkoutSet[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  id                            String             @id @default(uuid()) @db.Uuid
  userId                        String             @unique @db.Uuid
  displayName                   String
  timezone                      String             @default("Europe/Paris")
  weightUnit                    WeightUnit         @default(KG)
  distanceUnit                  DistanceUnit       @default(KM)
  primaryGoal                   TrainingGoal       @default(GENERAL_FITNESS)
  experienceLevel               ExperienceLevel    @default(BEGINNER)
  effortTrackingMode            EffortTrackingMode @default(NONE)
  heightCm                      Decimal?           @db.Decimal(5, 2)
  currentWeightKg               Decimal?           @db.Decimal(6, 2)
  weeklyTrainingTarget          Int?
  defaultWorkoutDurationMinutes Int?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model MuscleGroup {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  parentId  String?  @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MuscleGroup?  @relation("MuscleGroupHierarchy", fields: [parentId], references: [id])
  children MuscleGroup[] @relation("MuscleGroupHierarchy")

  primaryExercises   Exercise[]                 @relation("ExercisePrimaryMuscle")
  secondaryExercises ExerciseSecondaryMuscle[]

  @@index([parentId])
  @@index([isActive])
  @@map("muscle_groups")
}

model EquipmentType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForExercises      Exercise[]                        @relation("ExerciseDefaultEquipment")
  compatibleExercises      ExerciseEquipmentCompatibility[]
  preferredInPreferences   UserExercisePreference[]
  workoutTemplateExercises WorkoutTemplateExercise[]
  workoutSessionExercises  WorkoutSessionExercise[]

  @@index([isActive])
  @@map("equipment_types")
}

enum ExerciseSource {
  SYSTEM
  USER
}

enum ExerciseMeasurementType {
  WEIGHT_REPS
  BODYWEIGHT_REPS
  ASSISTED_BODYWEIGHT_REPS
  REPS_ONLY
  DURATION
  DISTANCE_DURATION
  WEIGHT_DURATION
}

model Exercise {
  id                     String                   @id @default(uuid()) @db.Uuid
  ownerUserId            String?                  @db.Uuid
  source                 ExerciseSource
  name                   String
  normalizedName         String
  slug                   String?                  @unique
  primaryMuscleGroupId   String                   @db.Uuid
  measurementType        ExerciseMeasurementType
  defaultEquipmentTypeId String?                  @db.Uuid
  defaultRestSeconds     Int?
  instructions           String?
  archivedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  owner                  User?                             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  primaryMuscleGroup     MuscleGroup                       @relation("ExercisePrimaryMuscle", fields: [primaryMuscleGroupId], references: [id])
  defaultEquipmentType   EquipmentType?                    @relation("ExerciseDefaultEquipment", fields: [defaultEquipmentTypeId], references: [id])
  secondaryMuscles       ExerciseSecondaryMuscle[]
  compatibleEquipment    ExerciseEquipmentCompatibility[]
  userPreferences          UserExercisePreference[]
  workoutTemplateExercises WorkoutTemplateExercise[]
  workoutSessionExercises  WorkoutSessionExercise[]

  @@index([ownerUserId])
  @@index([source])
  @@index([primaryMuscleGroupId])
  @@index([archivedAt])
  @@index([normalizedName, id])
  @@map("exercises")
}

model ExerciseSecondaryMuscle {
  exerciseId    String @db.Uuid
  muscleGroupId String @db.Uuid

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id])

  @@id([exerciseId, muscleGroupId])
  @@map("exercise_secondary_muscles")
}

model ExerciseEquipmentCompatibility {
  id              String  @id @default(uuid()) @db.Uuid
  exerciseId      String  @db.Uuid
  equipmentTypeId String  @db.Uuid
  isPreferred     Boolean @default(false)
  notes           String?

  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@unique([exerciseId, equipmentTypeId])
  @@index([equipmentTypeId])
  @@map("exercise_equipment_compatibilities")
}

model UserExercisePreference {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @db.Uuid
  exerciseId                String   @db.Uuid
  isFavorite                Boolean  @default(false)
  isExcludedFromSuggestions Boolean  @default(false)
  preferredEquipmentTypeId  String?  @db.Uuid
  restSecondsOverride       Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise               Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  preferredEquipmentType EquipmentType? @relation(fields: [preferredEquipmentTypeId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId])
  @@index([userId, isFavorite])
  @@map("user_exercise_preferences")
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Program {
  id          String        @id @default(uuid()) @db.Uuid
  ownerUserId String        @db.Uuid
  name        String
  description String?
  goal        TrainingGoal
  status      ProgramStatus @default(DRAFT)
  activatedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner            User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  workoutTemplates WorkoutTemplate[]
  activations      ProgramActivation[]
  scheduleEntries  ProgramScheduleEntry[]
  sourceSessions   WorkoutSession[]

  @@index([ownerUserId, archivedAt])
  @@index([ownerUserId, updatedAt, id])
  @@map("programs")
}

model ProgramActivation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  programId String    @db.Uuid
  startedOn DateTime  @db.Date
  endedOn   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId, endedOn])
  @@index([programId])
  @@map("program_activations")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ProgramScheduleEntry {
  id                String  @id @default(uuid()) @db.Uuid
  programId         String  @db.Uuid
  workoutTemplateId String  @db.Uuid
  weekday           Weekday
  position          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  program         Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  workoutTemplate WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)

  @@unique([programId, weekday, position])
  @@index([programId, weekday])
  @@index([workoutTemplateId])
  @@map("program_schedule_entries")
}

model WorkoutTemplate {
  id                       String    @id @default(uuid()) @db.Uuid
  ownerUserId              String    @db.Uuid
  programId                String    @db.Uuid
  name                     String
  description              String?
  positionInProgram        Int
  estimatedDurationMinutes Int?
  archivedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  owner   User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises WorkoutTemplateExercise[]
  scheduleEntries ProgramScheduleEntry[]
  sourceSessions  WorkoutSession[]

  @@unique([programId, positionInProgram])
  @@index([ownerUserId])
  @@index([programId])
  @@map("workout_templates")
}

enum WorkoutSetType {
  WARMUP
  WORKING
  BACKOFF
  DROP_SET
  AMRAP
  FAILURE_OPTIONAL
}

model WorkoutTemplateExercise {
  id                  String   @id @default(uuid()) @db.Uuid
  workoutTemplateId   String   @db.Uuid
  exerciseId          String   @db.Uuid
  position            Int
  equipmentTypeId     String?  @db.Uuid
  restSecondsOverride Int?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workoutTemplate WorkoutTemplate      @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise        Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  equipmentType   EquipmentType?       @relation(fields: [equipmentTypeId], references: [id], onDelete: SetNull)
  sets            WorkoutTemplateSet[]
  sourceSessionExercises WorkoutSessionExercise[]

  @@unique([workoutTemplateId, exerciseId])
  @@unique([workoutTemplateId, position])
  @@index([exerciseId])
  @@index([equipmentTypeId])
  @@map("workout_template_exercises")
}

model WorkoutTemplateSet {
  id                        String         @id @default(uuid()) @db.Uuid
  workoutTemplateExerciseId String         @db.Uuid
  position                  Int
  setType                   WorkoutSetType
  targetRepMin              Int?
  targetRepMax              Int?
  targetDurationSeconds     Int?
  targetDistanceMeters      Decimal?       @db.Decimal(10, 2)
  targetWeightKg            Decimal?       @db.Decimal(8, 3)
  targetIntensityPercent    Decimal?       @db.Decimal(5, 2)
  targetRir                 Int?
  targetRpe                 Decimal?       @db.Decimal(4, 1)
  restSeconds               Int?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  workoutTemplateExercise WorkoutTemplateExercise @relation(fields: [workoutTemplateExerciseId], references: [id], onDelete: Cascade)
  sourceSessionSets       WorkoutSet[]

  @@unique([workoutTemplateExerciseId, position])
  @@index([workoutTemplateExerciseId])
  @@map("workout_template_sets")
}

enum WorkoutStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// Statuts de performance réelle d’une série de séance.
/// À la création du snapshot (3.1+), le statut est toujours PENDING.
enum WorkoutSetStatus {
  PENDING
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
  CANCELLED
}

model WorkoutSession {
  id                          String        @id @default(uuid()) @db.Uuid
  ownerUserId                 String        @db.Uuid
  sourceProgramId             String?       @db.Uuid
  sourceWorkoutTemplateId     String?       @db.Uuid
  programNameSnapshot         String?
  workoutTemplateNameSnapshot String?
  name                        String
  status                      WorkoutStatus
  localDate                   DateTime      @db.Date
  timezone                    String
  startedAt                   DateTime
  pausedAt                    DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  cancellationReason          String?
  notes                       String?
  version                     Int           @default(1)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  owner                   User                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sourceProgram           Program?                 @relation(fields: [sourceProgramId], references: [id], onDelete: SetNull)
  sourceWorkoutTemplate   WorkoutTemplate?         @relation(fields: [sourceWorkoutTemplateId], references: [id], onDelete: SetNull)
  exercises               WorkoutSessionExercise[]
  lifecycleCommands       WorkoutLifecycleCommand[]

  @@index([ownerUserId, status])
  @@index([ownerUserId, localDate])
  @@index([sourceProgramId])
  @@index([sourceWorkoutTemplateId])
  @@map("workout_sessions")
}

/// Idempotence des commandes de cycle de vie (pause / reprise / fin / annulation).
model WorkoutLifecycleCommand {
  id                 String   @id @default(uuid()) @db.Uuid
  ownerUserId        String   @db.Uuid
  workoutSessionId   String   @db.Uuid
  clientCommandId    String
  action             String
  payloadFingerprint String
  createdAt          DateTime @default(now())

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, clientCommandId])
  @@index([workoutSessionId])
  @@map("workout_lifecycle_commands")
}

model WorkoutSessionExercise {
  id                               String                   @id @default(uuid()) @db.Uuid
  workoutSessionId                 String                   @db.Uuid
  sourceExerciseId                 String?                  @db.Uuid
  sourceTemplateExerciseId         String?                  @db.Uuid
  exerciseNameSnapshot             String
  measurementTypeSnapshot          ExerciseMeasurementType
  position                         Int
  primaryMuscleGroupNameSnapshot   String?
  sourceExerciseArchivedAtCreation Boolean                  @default(false)
  equipmentTypeId                  String?                  @db.Uuid
  equipmentNameSnapshot            String?
  equipmentCodeSnapshot            String?
  notesSnapshot                    String?
  restSecondsSnapshot              Int?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt

  workoutSession         WorkoutSession         @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sourceExercise         Exercise?              @relation(fields: [sourceExerciseId], references: [id], onDelete: SetNull)
  sourceTemplateExercise WorkoutTemplateExercise? @relation(fields: [sourceTemplateExerciseId], references: [id], onDelete: SetNull)
  equipmentType          EquipmentType?         @relation(fields: [equipmentTypeId], references: [id], onDelete: SetNull)
  sets                   WorkoutSet[]

  @@unique([workoutSessionId, position])
  @@index([workoutSessionId])
  @@index([sourceExerciseId])
  @@index([sourceTemplateExerciseId])
  @@index([equipmentTypeId])
  @@map("workout_session_exercises")
}

model WorkoutSet {
  id                        String            @id @default(uuid()) @db.Uuid
  workoutSessionExerciseId  String            @db.Uuid
  ownerUserId               String            @db.Uuid
  sourceTemplateSetId       String?           @db.Uuid
  position                  Int
  setType                   WorkoutSetType
  status                    WorkoutSetStatus  @default(PENDING)
  targetWeightKg            Decimal?          @db.Decimal(8, 3)
  targetRepMin              Int?
  targetRepMax              Int?
  targetDurationSeconds     Int?
  targetDistanceMeters      Decimal?          @db.Decimal(10, 2)
  targetIntensityPercent    Decimal?          @db.Decimal(5, 2)
  targetRir                 Int?
  targetRpe                 Decimal?          @db.Decimal(4, 1)
  targetRestSeconds         Int?
  actualWeightKg            Decimal?          @db.Decimal(8, 3)
  actualReps                Int?
  actualDurationSeconds     Int?
  actualDistanceMeters      Decimal?          @db.Decimal(10, 2)
  actualRir                 Int?
  actualRpe                 Decimal?          @db.Decimal(4, 1)
  reachedFailure            Boolean           @default(false)
  notes                     String?
  startedAt                 DateTime?
  completedAt               DateTime?
  clientCommandId           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  workoutSessionExercise WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)
  owner                  User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sourceTemplateSet      WorkoutTemplateSet?    @relation(fields: [sourceTemplateSetId], references: [id], onDelete: SetNull)

  @@unique([workoutSessionExerciseId, position])
  @@unique([ownerUserId, clientCommandId])
  @@index([workoutSessionExerciseId])
  @@index([ownerUserId, completedAt])
  @@index([sourceTemplateSetId])
  @@map("workout_sets")
}
