# =============================================================================
# Gym Companion — production environment template
# =============================================================================
# Copier vers `.env.prod` (gitignored) et remplacer TOUTES les valeurs CHANGE_ME.
# Ne jamais committer `.env.prod` ni réutiliser les secrets staging.
#
# Génération de secrets (exemple) :
#   openssl rand -hex 32
#
# Validation syntaxe Compose (sans démarrer) :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod config
# =============================================================================

# --- APP / runtime -----------------------------------------------------------
# Injecté aussi par compose pour l’API (NODE_ENV=production).
LOG_LEVEL=info

# --- DATABASE (Postgres service + API) ---------------------------------------
POSTGRES_USER=gym_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=gym_companion_prod

# URL complète vue depuis le réseau Docker interne (hostname = service `postgres`).
# IMPORTANT : encoder les caractères spéciaux du mot de passe (URL-encode).
# Exemple user/pass/db sans caractères spéciaux :
DATABASE_URL=postgresql://gym_prod:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/gym_companion_prod?schema=public

# --- URLS / CORS -------------------------------------------------------------
# Hosts conceptuels (à adapter si le DNS réel diffère) :
PUBLIC_APP_URL=https://gym.prumme.dev
API_BASE_URL=https://api.gym.prumme.dev
CORS_ALLOWED_ORIGINS=https://gym.prumme.dev

# --- AUTH (secrets distincts du staging, ≥ 32 caractères) --------------------
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- EMAIL -------------------------------------------------------------------
# Prod V1 : pas de Mailpit. `none` = pas d’envoi réel (reset password loggé
# de façon non sensible). Un SMTP réel pourra être branché plus tard.
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@gym.prumme.dev
# SMTP_HOST=
# SMTP_PORT=587
EMAIL_VERIFICATION_REQUIRED=false

# --- PWA / FRONTEND BUILD ARGS -----------------------------------------------
# ATTENTION : variables VITE_* intégrées AU BUILD de l’image web.
# Modifier ces valeurs → rebuild obligatoire de gym-web (`docker compose build gym-web`).
VITE_PUBLIC_APP_URL=https://gym.prumme.dev
VITE_API_BASE_URL=https://api.gym.prumme.dev

# --- AI COACH (désactivé par défaut en première prod) ------------------------
# Le Coach déterministe (sans LLM) reste disponible.
AI_COACH_ENABLED=false
AI_COACH_PROVIDER=none
# Valeur ignorée tant que le Coach IA est disabled ; défaut compose = gpt-4o-mini
AI_COACH_MODEL=gpt-4o-mini
AI_COACH_API_KEY=
AI_COACH_TIMEOUT_MS=15000
AI_COACH_RATE_LIMIT_PER_MINUTE=5

# --- BACKUPS (scripts/prod/*.sh) ---------------------------------------------
# BACKUP_DIR=./backups/prod
# BACKUP_RETENTION_DAYS=7
