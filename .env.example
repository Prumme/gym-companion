# Shared / API
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://gym:gym@localhost:5433/gym_companion?schema=public
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Auth (required from Phase 0 jalon 4+)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars

# Email (Mailpit local — jalon 4+)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@gym-companion.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Web (Vite)
# Lu depuis la racine du monorepo via `envDir` dans apps/web/vite.config.ts.
# Obligatoire pour les builds de production. En développement Vite uniquement,
# un fallback http://localhost:3000 existe si VITE_API_BASE_URL est absent.
VITE_API_BASE_URL=http://localhost:3000
VITE_PUBLIC_APP_URL=http://localhost:5173

# Coach IA explicatif (jalon 5.5) — secrets serveur uniquement
# Désactivé par défaut : le Coach déterministe 5.4 reste disponible.
AI_COACH_ENABLED=false
# none | openai | fake (fake interdit en production)
AI_COACH_PROVIDER=none
# AI_COACH_API_KEY=
AI_COACH_MODEL=gpt-4o-mini
AI_COACH_TIMEOUT_MS=15000
AI_COACH_RATE_LIMIT_PER_MINUTE=5
