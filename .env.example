# Shared / API
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://gym:gym@localhost:5433/gym_companion?schema=public
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Auth (required from Phase 0 jalon 4+)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars

# Email (Mailpit local — jalon 4+)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@gym-companion.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Web (Vite)
VITE_API_BASE_URL=http://localhost:3000
VITE_PUBLIC_APP_URL=http://localhost:5173
